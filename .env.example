# Teammate AI — environment template (T-6.01)
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# git-ignored and must never be committed.
#
# EVERY variable here is server-only. Never prefix any of them with
# `NEXT_PUBLIC_`: that prefix inlines the value into the browser bundle and
# would publish your API keys to every visitor.

# ---------------------------------------------------------------------------
# Groq — text generation (FR-06, FR-09)
#
# The provider for ALL text generation (FR-06 task analysis, FR-09 explanation).
# Get a key from https://console.groq.com/keys; it starts with `gsk_`.
#
# Both variables are REQUIRED for the AI product to work. If either is missing,
# task analysis returns an error and FR-09 falls back to its deterministic
# template — the rest of the app keeps working. Set GROQ_MODEL_TEXT to a model
# that is actually available on your account: groqChat posts to
# `${GROQ_BASE_URL}/chat/completions` and a retired model id yields HTTP 404.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
# OpenAI-compatible endpoint. Override only for a proxy or a test double.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Example: llama-3.3-70b-versatile
GROQ_MODEL_TEXT=

# ---------------------------------------------------------------------------
# Google Gemini — embeddings only
#
# KEPT ON PURPOSE. Text generation moves to Groq, but embeddings have no
# verified replacement yet, so GEMINI_API_KEY and GEMINI_MODEL_EMBED stay.
# Do not delete them during the migration.
#
# GEMINI_MODEL_TEXT is no longer used for text generation (moved to Groq in
# T-6.02). It is kept only so an existing .env.local keeps parsing unchanged.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL_TEXT=gemini-2.5-flash
GEMINI_MODEL_EMBED=text-embedding-004

# ---------------------------------------------------------------------------
# Supabase — database (server-only, secret key; never the anon key)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=
